# Safe local mode. This generates a deterministic price path and uses an openly labeled stand-in.
APP_MODE=demo
MODEL=demo
HOST=127.0.0.1
PORT=3015

# Public read-only Monad RPC, used only with APP_MODE=paper.
READ_RPC_URL=https://rpc.monad.xyz
# Optional comma-separated HTTPS backups. The bundled defaults are Monad's public, rate-limited RPC aliases;
# the recorder tries them sequentially only after a read failure and stores only the endpoint index.
# READ_RPC_FALLBACK_URLS=https://rpc1.monad.xyz,https://rpc2.monad.xyz,https://rpc3.monad.xyz
# Each HTTP read has a 5-second timeout before sequential failover to the next public endpoint.
MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394
BOOK_POLL_MS=1000
BOOK_STALE_AFTER_MS=5000
KURU_WS_STALE_AFTER_MS=60000
# Keep the paper engine idle when the best bid/ask spread is wider than this limit.
MAX_MARKET_SPREAD_BPS=50

# Paper mode can capture public market data with model decisions paused.
# Set MODEL=paused for collection only. No API credentials are needed.
# Optional Jev provider. Requests stay disabled unless explicitly enabled.
# Set JEV_REQUESTS_ENABLED=1 only when you intend to send Jev requests; no automatic model fallback is used.
# Provider requests also require a positive app-side daily cap. Each attempted call counts, even if it fails.
# MODEL_MAX_REQUESTS_PER_UTC_DAY=3
# OPENCODE_API_KEY is read by the server process only. Keep it in an untracked local .env.
# APP_MODE=paper
# MODEL=jev
# OPENCODE_API_KEY=
# JEV_REQUESTS_ENABLED=1
# Optional hosted Gemini provider. Create an API key in Google AI Studio and leave
# Gemini API billing unlinked to remain on Google's free API tier.
# MODEL=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
# GEMINI_REQUESTS_ENABLED=1
# Optional OpenCode Go gateway. Obtain an API key from your OpenCode Go account;
# the desktop app's login token is not written or reused by this project.
# MODEL=opencode-go
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_REQUESTS_ENABLED=1
# OPENCODE_GO_MODEL_ID=kimi-k3
# OPENCODE_GO_PROTOCOL=chat
# Model calls have no automatic provider fallback. Keep at least 10s between calls.
MODEL_DECISION_INTERVAL_MS=10000
GEMINI_REQUESTS_ENABLED=0
OPENCODE_GO_REQUESTS_ENABLED=0
# Use MODEL=demo with this opt-in only for local-heuristic paper execution tests; this is not Jev.
PAPER_LOCAL_DEMO_ENABLED=0
# This request-count cap is not a dollar spend limit. To opt in to paid Jev,
# also set a provider-side spending limit before enabling calls:
# JEV_MODEL_ID=jev-1.13
# JEV_ALLOW_PAID=1
JEV_DECISION_INTERVAL_MS=10000
JEV_TIMEOUT_MS=8000

# Paper controls only. No transaction signing or sending exists in this project.
PAPER_ORDER_SIZE_MON=200
PAPER_MAX_POSITION_MON=1000
PAPER_CASH_USD=100
PAPER_MAX_LOSS_USD=20
# Optional explicit paper fee override; otherwise live Kuru maker fees are read from market parameters.
# PAPER_FEE_BPS=10
